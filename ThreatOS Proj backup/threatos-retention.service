[Unit]
Description=ThreatOS data retention worker
After=network.target postgresql-15.service
Requires=postgresql-15.service

[Service]
Type=exec
User=root
WorkingDirectory=/opt/threatos
Environment="PATH=/opt/threatos/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/threatos/.venv/bin/python -m threatos.workers.retention_worker
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
