# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true

# ── Database ────────────────────────────────────────────────────────────────────
# Docker Compose network name: db
DATABASE_URL=postgresql+asyncpg://threatos:secret@localhost:5432/threatos
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_NAME=threatos:events:normalized
REDIS_STREAM_MAXLEN=100000

# ── ATT&CK ────────────────────────────────────────────────────────────────────
ATTCK_BUNDLE_URL=https://raw.githubusercontent.com/mitre/cti/master/enterprise-attack/enterprise-attack.json

# ── Workers ──────────────────────────────────────────────────────────────────
WORKER_BATCH_SIZE=500
WORKER_FLUSH_INTERVAL_MS=200

# ── Nmap ─────────────────────────────────────────────────────────────────────
# Oracle Linux 8: /usr/bin/nmap  (same path as Ubuntu after dnf install nmap)
NMAP_BINARY_PATH=/usr/bin/nmap
NMAP_DEFAULT_TIMEOUT=300

# ── Oracle Linux 8 notes ──────────────────────────────────────────────────────
# When running WITHOUT Docker on Oracle Linux 8:
#   python3.11 -m uvicorn threatos.main:app --host 0.0.0.0 --port 8000
#   python3.11 -m threatos.workers.ingest_worker
# All code is identical — only the Python binary name differs.
