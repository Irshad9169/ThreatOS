# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false

# ── Database — credentials from environment only ──────────────────────────────
DATABASE_URL=postgresql+asyncpg://threatos:threatos_secret@localhost:5432/threatos
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_NAME=threatos:events:normalized
REDIS_CONSUMER_GROUP=detection-workers
REDIS_CONSUMER_NAME=worker-1
WORKER_BATCH_SIZE=500
WORKER_BLOCK_MS=200

# ── JWT — strong random secrets ───────────────────────────────────────────────
JWT_SECRET_KEY=f49a71231754005bd632e2dc2fb0bc0be86cc2d44be00734ae6d7297375098cb
JWT_REFRESH_SECRET_KEY=674c512dc1f33e6086d319fa223f416dec2898e25e926f142c9049592ed02c54
JWT_ACCESS_EXPIRE_MINUTES=480
JWT_REFRESH_EXPIRE_DAYS=30

# ── Rate limiting ─────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Admin bootstrap ───────────────────────────────────────────────────────────
THREATOS_ADMIN_PASSWORD=ThreatOS@2026

# ── Workers ───────────────────────────────────────────────────────────────────
ASSET_CRITICALITY_TTL=300
COVERAGE_REFRESH_INTERVAL_SECONDS=3600

# ── ATT&CK ────────────────────────────────────────────────────────────────────
ATTCK_BUNDLE_URL=https://raw.githubusercontent.com/mitre/cti/master/enterprise-attack/enterprise-attack.json

# ── Nmap ──────────────────────────────────────────────────────────────────────
NMAP_BINARY_PATH=/usr/bin/nmap
NMAP_DEFAULT_TIMEOUT=300

# ── Data retention ────────────────────────────────────────────────────────────
RAW_EVENTS_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
LOGIN_ATTEMPTS_RETENTION_HOURS=24

# ── Threat Intelligence ───────────────────────────────────────────────────────
# Get free keys at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=b7bb290b0796203e96ca891a8aea56f5b8d1d0d353de94f35dba34f3d31014fd
# Get free keys at: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=7b072ec774cc49b4c94479e6f978b6a3a67c93e837ef2211f9b66c0a2e8e9a662865dd26877f5bfe
TI_CACHE_HOURS=24
TI_TIMEOUT_SECONDS=10

# Syslog forwarder
THREATOS_API_KEY=75c7347e6516796855895961dccad57489cd0adec26a0ed48f616f03d062930c
THREATOS_URL=http://localhost:8001
